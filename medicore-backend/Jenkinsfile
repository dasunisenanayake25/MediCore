pipeline {
    agent { label 'rootless-docker' }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test Backend') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker context show
                    docker build -t my-project-backend:latest .
                '''
            }
        }
    }

    post {
        success {
            echo 'CI pipeline completed successfully!'
        }
    }
}