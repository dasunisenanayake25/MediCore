pipeline {
    agent { label 'rootless-docker' }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Test') {
            steps {
                sh 'cd medicore-backend && npm ci && npm test'
            }
        }

        stage('Frontend Build') {
            steps {
                sh 'cd medicorefrontend && npm ci && npm run lint && npm run build'
            }
        }

        stage('Build Images') {
            steps {
                sh 'docker build -t medicore-backend:${BUILD_NUMBER} ./medicore-backend'
                sh 'docker build -t medicore-frontend:${BUILD_NUMBER} ./medicorefrontend'
            }
        }

        stage('Deploy') {
            steps {
                withEnv(["IMAGE_TAG=${BUILD_NUMBER}", "FRONTEND_PORT=${env.FRONTEND_PORT ?: '8081'}"]) {
                    sh 'docker compose up -d'
                    sh 'curl --fail --retry 10 --retry-all-errors --retry-connrefused --retry-delay 3 http://localhost:${FRONTEND_PORT}/api/health'
                }
            }
        }
    }
}