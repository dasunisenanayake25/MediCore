pipeline {
    agent { label 'rootless-docker' }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/dasunisenanayake25/MediCore.git'
            }
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }
}

environment {
    COMPOSE_DOCKER_CLI_BUILD = '1'
    DOCKER_BUILDKIT = '1'
    FRONTEND_PORT = '8082'
}

stages {
    stage('Checkout') {
        steps {
            git branch: 'main', url: 'https://github.com/dasunisenanayake25/MediCore.git'
        }
    }
}

stage('Verify Environment') {
    steps {
    sh '''
    whoami
    docker context show
    docker info | grep -i rootless || true
    '''
    }
}

stage('Build Docker Images') {
    steps {
        sh '''
        docker build -t medicore-backend:latest ./medicore-backend
        docker build -t medicore-frontend:latest ./medicorefrontend
        '''
    }
}

stage('Test Docker Compose Stack') {
    steps {
        sh '''
        docker compose down --remove-orphans || true
        docker compose up -d --build
        docker compose ps
        sleep 5
        curl -I http://localhost:8082 || true
        curl http://localhost:5000/api/health || true
        '''
    }
}   


post {
    always {
        sh 'docker compose down || true'
    }
    success {
        echo 'MediCore CI pipeline completed successfully on Rootless Docker!'
    }
    failure {
        echo 'CI pipeline failed. Please check console logs.'
    }
}
